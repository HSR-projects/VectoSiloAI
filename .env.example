# ─── KodaAI Private Cloud ────────────────────────────────────
# KodaAI uses its own private model infrastructure for inference.
# Get an API key from your KodaAI dashboard.
KODA_CLOUD_BASE_URL=https://cloud.kodaai.com
KODA_CLOUD_API_KEY=a93474b4df6045f9ba07018dafd77300.V6kaRtyvOYKzBFVK8E46SWeQ
KODA_DEFAULT_MODEL=gpt-oss:120b

# ─── Web search (SearXNG — PRIMARY) ──────────────────────────
# SearXNG is the primary web search provider for all features
# (chat search, voice agent, image search, product search).
# Self-hosted via Docker: https://docs.searxng.org
SEARXNG_BASE_URL=http://localhost:6767

# Optional: Brave Search fallback (used only if SearXNG is unavailable)
BRAVE_SEARCH_API_KEY=

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=KodaAI
NEXT_PUBLIC_APP_VERSION=1.0.0

# ─── Voice (STT + TTS) ────────────────────────────────────────
# faster-whisper STT server (run: python scripts/stt-server.py)
STT_SERVER_URL=http://127.0.0.1:5050/transcribe
# Piper TTS binary + model (installed at /opt/voip-ai/tts/)
TTS_PIPER_BIN=/opt/voip-ai/tts/piper
TTS_PIPER_MODEL=/opt/voip-ai/tts/voices/en_US-ljspeech-high.onnx

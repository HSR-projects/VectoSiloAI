# ─── KodaAI Private Cloud ────────────────────────────────────
# KodaAI uses its own private model infrastructure for inference.
# Get an API key from your KodaAI dashboard.
KODA_CLOUD_BASE_URL=https://cloud.kodaai.com
KODA_CLOUD_API_KEY=your_kodaai_api_key_here
KODA_DEFAULT_MODEL=koda-1

# ─── Web search ────────────────────────────────────────────────
# Primary backend is the KodaAI Private Cloud Search API, which
# reuses KODA_CLOUD_API_KEY — no separate search key or server.
#
# SearXNG (below) is only used as a fallback, e.g. when pointing
# at a local setup that has no web search.
SEARXNG_BASE_URL=http://localhost:8080

# Optional: Brave Search fallback (used only if the above are unavailable)
BRAVE_SEARCH_API_KEY=

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=KodaAI
NEXT_PUBLIC_APP_VERSION=1.0.0
